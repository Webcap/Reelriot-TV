# Caffeine TV - copy to .env and fill in
TMDB_API_KEY=
# For Android TV emulator, use your host machine: http://10.0.2.2:3000 (replace 3000 with API port)
# For production or physical device on same network, use your API URL
CAFFEINE_API_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: URL of the pairing page where users enter the TV code
PAIRING_PAGE_URL=
# Optional: set to true/1/yes to require sign-in before using the app (default: login optional)
# REQUIRE_LOGIN=
